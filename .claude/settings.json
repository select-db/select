{
	"outputStyle": "Caveman",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "mcp__github__create_pull_request",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-review-gate.sh pr-opened",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Skill",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-review-gate.sh skill-ran",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Agent|Task",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-review-gate.sh agent-ran",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-review-gate.sh stop",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/skills/dialect-fixer/scripts/publish.sh",
						"timeout": 180
					}
				]
			}
		]
	}
}
