# IDE/editor files
.vscode/
.idea/
.mcp.json
*.iml
*.swp
*.swo
*.bak


# System files
.DS_Store
Thumbs.db

notes.txt

# Compiled binaries
backend/server
app/selectDb

# Generated website
web/dist/
# Per-build staging directories, renamed into web/dist when a build finishes.
web/dist.staging-*

# Local release config: SSH_HOST, MINISIGN_SECRET_KEY path, etc.
.env.release

# Minisign secret keys. The public key (minisign.pub) is committed;
*.sec
# Build cache: the fetched Scalar bundle and the GitHub star count
web/.cache/

# Generator binary (build with: go build ./web/generate)
web/generate/generate
