[Unit]
Description=selectDb backend
# Start after the network stack and postgres are ready
After=network.target postgresql.service
# Pull in postgres if available, but don't fail if it's on a separate host
Wants=postgresql.service

[Service]
# simple: systemd considers the service up as soon as ExecStart spawns
Type=simple
# Run as a dedicated unprivileged user, never root
User=selectdb
Group=selectdb
WorkingDirectory=/opt/selectdb/backend

# Env file is patched by setup-server.sh to point to env.staging or env.prod
EnvironmentFile=/opt/selectdb/env.prod

ExecStart=/opt/selectdb/backend/selectdb-backend
# SIGHUP triggers a config reload without a full restart
ExecReload=/bin/kill -HUP $MAINPID

# Give in-flight requests and WebSocket connections time to drain
TimeoutStopSec=15
# mixed: send SIGTERM to the main process, SIGKILL to any remaining children after timeout
KillMode=mixed
KillSignal=SIGTERM

# Restart the process on crash, but not on clean exit or explicit stop
Restart=on-failure
# Wait 5s before restarting to avoid hammering a broken dependency
RestartSec=5

# Each SSH tunnel holds 2 file descriptors (TCP socket + local listener).
# At 1000 concurrent tunnels that's 2000 fds before accounting for DB connections
# and open files. Default kernel per-process limit is 1024, raise it to 64K.
LimitNOFILE=65536

# Hardening
# Prevent the process from gaining new privileges via setuid/capabilities
NoNewPrivileges=true
# Mount a private /tmp, isolated from the rest of the system
PrivateTmp=true
# Mount /usr, /boot, /etc as read-only to prevent tampering
ProtectSystem=strict
# Whitelist the one directory the process legitimately writes to
ReadWritePaths=/opt/selectdb

[Install]
# Start this service when the system reaches the standard multi-user runlevel
WantedBy=multi-user.target
