# Copy to /opt/selectdb/env.staging or /opt/selectdb/env.prod on the server.
# Never commit real values.

# PostgreSQL connection string
DB_DSN=postgres://selectdb:password@localhost:5432/selectdb?sslmode=disable

# JWT signing key. Dev only: in-process RSA key at this path. In prod the
# signing key is an OVH KMS asymmetric key (set OVH_KMS_JWT_KEY_ID + the
# OVH_KMS_* vars below) and this path is unused. The public half is derived
# from the signer, so no public key path is needed.
PRIVATE_KEY_PATH=/opt/selectdb/keys/private.pem

# OVH KMS (prod). Holds the datasource KEK and the JWT signing key; key material
# never leaves the KMS. Dev uses SELECTDB_KEK instead and omits all of these.
OVH_KMS_ENDPOINT=https://eu-west-rbx.okms.ovh.net
OVH_KMS_CERT_FILE=/opt/selectdb/keys/kms-access.crt
OVH_KMS_KEY_FILE=/opt/selectdb/keys/kms-access.key
OVH_KMS_OKMS_ID=
OVH_KMS_KEK_ID=           # OVH service key (symmetric) used as the KEK for datasource DEKs
OVH_KMS_JWT_KEY_ID=       # asymmetric key signing JWTs

# Dev/local only: 32-byte base64 KEK held in process. Set this to bypass OVH KMS.
# SELECTDB_KEK=

# GitHub OAuth app (for device-flow auth, only client ID needed)
GITHUB_CLIENT_ID=

# Releases-download root returned to clients by /version as release_base_url
# (the tag is appended automatically). Lets the release repo move without
# re-shipping clients. Leave empty to let clients use their built-in fallback.
# Production builds verify the minisign signature regardless of this value.
RELEASE_BASE_URL=https://github.com/select-db/select/releases/download

# Server port (optional, defaults to 8080 in code)
PORT=8080

# dev | staging | production
APP_ENV=production
