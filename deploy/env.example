# Copy to /opt/selectdb/env.staging or /opt/selectdb/env.prod on the server.
# Never commit real values.

# PostgreSQL connection string
DB_DSN=postgres://selectdb:password@localhost:5432/selectdb?sslmode=disable

# RSA key paths (absolute paths on the server)
PRIVATE_KEY_PATH=/opt/selectdb/keys/private.pem
PUBLIC_KEY_PATH=/opt/selectdb/keys/public.pem

# GitHub OAuth app (for device-flow auth, only client ID needed)
GITHUB_CLIENT_ID=

# Secret used to sign refresh tokens (run: openssl rand -hex 32)
REFRESH_TOKEN_SECRET=

# Releases-download root returned to clients by /version as release_base_url
# (the tag is appended automatically). Lets the release repo move without
# re-shipping clients. Leave empty to let clients use their built-in fallback.
# Production builds verify the minisign signature regardless of this value.
RELEASE_BASE_URL=https://github.com/select-db/select/releases/download

# Server port (optional, defaults to 8080 in code)
PORT=8080

# dev | staging | production
APP_ENV=production
