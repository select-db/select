{
  "resources": [
    {
      "name": "role",
      "operations": {
        "create": {
          "requires": [
            "roles.manage"
          ]
        },
        "delete": {
          "requires": [
            "roles.manage"
          ]
        },
        "get": {},
        "list": {},
        "update": {
          "requires": [
            "roles.manage"
          ]
        }
      },
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "filterable": false,
          "sortable": true,
          "selectable": true
        },
        {
          "name": "name",
          "type": "text",
          "filterable": true,
          "operators": [
            "eq",
            "ne",
            "in",
            "nin",
            "like",
            "ilike",
            "is_null",
            "not_null"
          ],
          "sortable": true,
          "selectable": true
        },
        {
          "name": "updated_at",
          "type": "time",
          "filterable": false,
          "sortable": true,
          "selectable": true
        }
      ]
    }
  ]
}