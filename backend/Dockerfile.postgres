# Local dev Postgres with pg_partman available.
#
# pg_partman is pinned to 4.7.4, the only version OVH managed Postgres (prod)
# offers, and built from source since PGDG only ships 5.x. Staging pins the same.
# NO_BGW: maintenance runs from pg_cron, so the background worker is not needed.
FROM postgres:17

ARG PG_PARTMAN_VERSION=4.7.4
ARG PG_PARTMAN_SHA256=e81e9b4edbd36490be6389e2a593cac9a55b1694ba84f8fd4b08df5b17d6233e

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates make gcc postgresql-server-dev-17 \
    && curl -fsSL -o /tmp/pg_partman.tar.gz "https://github.com/pgpartman/pg_partman/archive/refs/tags/v${PG_PARTMAN_VERSION}.tar.gz" \
    && echo "${PG_PARTMAN_SHA256}  /tmp/pg_partman.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/pg_partman.tar.gz -C /tmp \
    && make -C "/tmp/pg_partman-${PG_PARTMAN_VERSION}" NO_BGW=1 install \
    && rm -rf /tmp/pg_partman* \
    && apt-get purge -y --auto-remove curl make gcc postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*
