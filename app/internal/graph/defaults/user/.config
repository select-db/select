{
  "keybindings": {
    "workbench": [
      {
        "key": "secondary+p",
        "command": "workbench.openSearch",
        "when": "!menuFocus"
      },
      {
        "key": "secondary+w",
        "command": "workbench.closeActiveTab",
        "when": "!menuFocus"
      },
      {
        "key": "ctrl+-",
        "command": "workbench.previousTabInGroup",
        "when": "!menuFocus && os == 'macos'"
      },
      {
        "key": "ctrl+shift+-",
        "command": "workbench.nextTabInGroup",
        "when": "!menuFocus && os == 'macos'"
      },
      {
        "key": "secondary+alt+-",
        "command": "workbench.previousTabInGroup",
        "when": "!menuFocus && os != 'macos'"
      },
      {
        "key": "secondary+shift+-",
        "command": "workbench.nextTabInGroup",
        "when": "!menuFocus && os != 'macos'"
      },
      {
        "key": "secondary+j",
        "command": "workbench.toggleLeftPanel"
      },
      {
        "key": "secondary+k",
        "command": "workbench.toggleRightPanel"
      },
      {
        "key": "secondary+shift+e",
        "command": "workbench.toggleFiles"
      },
      {
        "key": "secondary+alt+g",
        "command": "workbench.toggleGit"
      },
      {
        "key": "secondary+shift+f",
        "command": "workbench.toggleSearch"
      },
      {
        "key": "secondary+=",
        "command": "workbench.zoomIn"
      },
      {
        "key": "secondary+-",
        "command": "workbench.zoomOut"
      },
      {
        "key": "secondary+0",
        "command": "workbench.zoomReset"
      },
      {
        "key": "ctrl+`",
        "command": "workbench.openTerminal",
        "when": "!menuFocus"
      },
      {
        "key": "secondary+n",
        "command": "workbench.newSqlFile",
        "when": "!menuFocus"
      }
    ],
    "editor": [
      {
        "key": "secondary+s",
        "command": "editor.formatDocument",
        "when": "editorFocus"
      },
      {
        "key": "secondary+enter",
        "command": "editor.runQuery",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+d",
        "command": "editor.toggleDatabasePicker"
      },
      {
        "key": "secondary+z",
        "command": "editor.undo",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+z",
        "command": "editor.redo",
        "when": "editorFocus"
      },
      {
        "key": "secondary+y",
        "command": "editor.redo",
        "when": "editorFocus"
      },
      {
        "key": "secondary+a",
        "command": "editor.selectAll",
        "when": "editorFocus"
      },
      {
        "key": "secondary+f",
        "command": "editor.find",
        "when": "editorFocus"
      },
      {
        "key": "secondary+h",
        "command": "editor.replace",
        "when": "editorFocus"
      },
      {
        "key": "secondary+g",
        "command": "editor.findNext",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+g",
        "command": "editor.findPrevious",
        "when": "editorFocus"
      },
      {
        "key": "secondary+d",
        "command": "editor.addSelectionToNextMatch",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+l",
        "command": "editor.selectAllOccurrences",
        "when": "editorFocus"
      },
      {
        "key": "secondary+l",
        "command": "editor.selectLine",
        "when": "editorFocus"
      },
      {
        "key": "secondary+/",
        "command": "editor.toggleLineComment",
        "when": "editorFocus"
      },
      {
        "key": "secondary+[",
        "command": "editor.outdent",
        "when": "editorFocus"
      },
      {
        "key": "secondary+]",
        "command": "editor.indent",
        "when": "editorFocus"
      },
      {
        "key": "secondary+u",
        "command": "editor.cursorUndo",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+k",
        "command": "editor.deleteLine",
        "when": "editorFocus"
      },
      {
        "key": "shift+enter",
        "command": "editor.insertLineAfter",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+enter",
        "command": "editor.insertLineBefore",
        "when": "editorFocus"
      },
      {
        "key": "alt+up",
        "command": "editor.moveLineUp",
        "when": "editorFocus"
      },
      {
        "key": "alt+down",
        "command": "editor.moveLineDown",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+up",
        "command": "editor.copyLineUp",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+down",
        "command": "editor.copyLineDown",
        "when": "editorFocus"
      },
      {
        "key": "alt+left",
        "command": "editor.cursorWordLeft",
        "when": "editorFocus"
      },
      {
        "key": "alt+right",
        "command": "editor.cursorWordRight",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+left",
        "command": "editor.cursorWordLeftSelect",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+right",
        "command": "editor.cursorWordRightSelect",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+[",
        "command": "editor.fold",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+]",
        "command": "editor.unfold",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+f",
        "command": "editor.formatSelection",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+o",
        "command": "editor.goToSymbol",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+i",
        "command": "editor.insertCursorAtEndOfEachLine",
        "when": "editorFocus"
      },
      {
        "key": "secondary+alt+up",
        "command": "editor.addCursorAbove",
        "when": "editorFocus"
      },
      {
        "key": "secondary+alt+down",
        "command": "editor.addCursorBelow",
        "when": "editorFocus"
      },
      {
        "key": "secondary+alt+left",
        "command": "editor.cursorWordLeftSelect",
        "when": "editorFocus"
      },
      {
        "key": "secondary+alt+right",
        "command": "editor.cursorWordRightSelect",
        "when": "editorFocus"
      },
      {
        "key": "secondary+backspace",
        "command": "editor.deleteAllLeft",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+backspace",
        "command": "editor.deleteWordLeft",
        "when": "editorFocus"
      },
      {
        "key": "secondary+delete",
        "command": "editor.deleteAllRight",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+delete",
        "command": "editor.deleteWordRight",
        "when": "editorFocus"
      },
      {
        "key": "secondary+up",
        "command": "editor.goToTop",
        "when": "editorFocus && os == 'macos'"
      },
      {
        "key": "ctrl+home",
        "command": "editor.goToTop",
        "when": "editorFocus && os != 'macos'"
      },
      {
        "key": "secondary+down",
        "command": "editor.goToBottom",
        "when": "editorFocus && os == 'macos'"
      },
      {
        "key": "ctrl+end",
        "command": "editor.goToBottom",
        "when": "editorFocus && os != 'macos'"
      },
      {
        "key": "secondary+left",
        "command": "editor.goToLineStart",
        "when": "editorFocus"
      },
      {
        "key": "secondary+right",
        "command": "editor.goToLineEnd",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+left",
        "command": "editor.selectToLineStart",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+right",
        "command": "editor.selectToLineEnd",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+up",
        "command": "editor.selectToTop",
        "when": "editorFocus && os == 'macos'"
      },
      {
        "key": "ctrl+shift+home",
        "command": "editor.selectToTop",
        "when": "editorFocus && os != 'macos'"
      },
      {
        "key": "secondary+shift+down",
        "command": "editor.selectToBottom",
        "when": "editorFocus && os == 'macos'"
      },
      {
        "key": "ctrl+shift+end",
        "command": "editor.selectToBottom",
        "when": "editorFocus && os != 'macos'"
      },
      {
        "key": "shift+alt+a",
        "command": "editor.blockComment",
        "when": "editorFocus"
      },
      {
        "key": "shift+alt+d",
        "command": "editor.duplicateSelection",
        "when": "editorFocus"
      },
      {
        "key": "ctrl+pageup",
        "command": "editor.scrollLineUp",
        "when": "editorFocus && os == 'macos'"
      },
      {
        "key": "ctrl+up",
        "command": "editor.scrollLineUp",
        "when": "editorFocus && os != 'macos'"
      },
      {
        "key": "ctrl+pagedown",
        "command": "editor.scrollLineDown",
        "when": "editorFocus && os == 'macos'"
      },
      {
        "key": "ctrl+down",
        "command": "editor.scrollLineDown",
        "when": "editorFocus && os != 'macos'"
      },
      {
        "key": "secondary+shift+space",
        "command": "editor.triggerParameterHints",
        "when": "editorFocus"
      },
      {
        "key": "secondary+alt+[",
        "command": "editor.foldAll",
        "when": "editorFocus"
      },
      {
        "key": "secondary+alt+]",
        "command": "editor.unfoldAll",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+\\",
        "command": "editor.jumpToBracket",
        "when": "editorFocus"
      },
      {
        "key": "secondary+shift+.",
        "command": "editor.quickFix",
        "when": "editorFocus"
      }
    ],
    "modal": [
      {
        "key": "escape",
        "command": "modal.close",
        "when": "modalOpen"
      }
    ],
    "menu": [
      {
        "key": "escape",
        "command": "menu.close",
        "when": "menuFocus"
      },
      {
        "key": "down",
        "command": "menu.selectNext",
        "when": "menuFocus"
      },
      {
        "key": "secondary+down",
        "command": "menu.selectNext",
        "when": "menuFocus"
      },
      {
        "key": "secondary+p",
        "command": "menu.selectNext",
        "when": "menuFocus"
      },
      {
        "key": "up",
        "command": "menu.selectPrevious",
        "when": "menuFocus"
      },
      {
        "key": "secondary+up",
        "command": "menu.selectPrevious",
        "when": "menuFocus"
      },
      {
        "key": "enter",
        "command": "menu.confirm",
        "when": "menuFocus"
      },
      {
        "key": "secondary+enter",
        "command": "menu.confirm",
        "when": "menuFocus"
      }
    ]
  },
  "editor_snippets": [
    {
      "prefix": "select",
      "body": "SELECT ${2} FROM ${1}",
      "description": "SELECT ... FROM ..."
    }
  ]
}
