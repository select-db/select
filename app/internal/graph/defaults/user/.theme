:root {
  /* Font sizes */
  --fs-xxs: 0.60rem;
  --fs-xs: 0.70rem;
  --fs-sm: 0.78rem;
  --fs-md: 0.875rem;
  --fs-lg: 1rem;
  --fs-xl: 1.125rem;
  --fs-xxl: 1.5rem;

  /* Font weights */
  --fw-light: 300;
  --fw-normal: 400;
  --fw-md: 500;
  --fw-bold: 600;

  /* Border */
  --bw: .5px;
  --br-xs: 0.25rem;
  --br-sm: 0.375rem;
  --br-md: 0.5rem;
  --br-lg: 0.75rem;
  --br-xl: 1rem;
}

:root[data-theme="light"] {
  --hue: 240;

  /* Gray scale */
  --gray-0:    hsl(var(--hue), 6%, 97%);
  --gray-100:  hsl(var(--hue), 5%, 95%);
  --gray-200:  hsl(var(--hue), 6%, 99%);
  --gray-300:  hsl(var(--hue), 5%, 96%);
  --gray-400:  hsl(var(--hue), 5%, 94%);
  --gray-500:  hsl(var(--hue), 5%, 89%);
  --gray-550:  hsl(var(--hue), 5%, 85%);
  --gray-600:  hsl(var(--hue), 5%, 72%);
  --gray-700:  hsl(var(--hue), 4%, 55%);
  --gray-800:  hsl(var(--hue), 4%, 38%);
  --gray-900:  hsl(var(--hue), 3%, 22%);
  --gray-1000: hsl(var(--hue), 3%, 15%);
  --gray-1050: hsl(var(--hue), 3%, 11%);

  /* Border */
  --border-color: hsl(0, 0%, 90%);
  --border-color-contrast: hsl(0, 0%, 90%);

  /* Accent colors */
  --red:         rgb(220, 53, 53);
  --blue:        rgb(59, 130, 246);
  --green:       rgb(34, 197, 94);
  --green-dark:  rgb(22, 163, 74);
  --yellow:      rgb(234, 179, 8);
  --orange:      rgb(249, 115, 22);
  --orange-dark: rgb(234, 88, 12);
  --purple:      rgb(139, 92, 246);
  --purple-dark: rgb(245, 240, 255);

  /* Glow effects */
  --red-glow:   rgb(255, 80, 80);
  --green-glow: rgb(0, 210, 130);
  --blue-glow:  rgb(59, 130, 246);
  --white-glow: rgb(200, 220, 255);
}

:root[data-theme="dark"] {
  --hue: 240;

  /* Gray scale,  saturation tapers from rich (deep surfaces) to neutral (text) */
  --gray-0:    hsl(0, 0%, 3%);
  --gray-100:  hsl(var(--hue), 5%, 4%);
  --gray-200:  hsl(var(--hue), 3%, 6%);
  --gray-300:  hsl(280, 3%, 9%);
  --gray-400:  hsl(var(--hue), 1%, 18%);
  --gray-500:  hsl(0, 0%, 26%);
  --gray-600:  hsl(var(--hue), 14%, 28%);
  --gray-700:  hsl(0, 0%, 40%);
  --gray-550:  hsl(0, 0%, 46%);
  --gray-800:  hsl(var(--hue), 5%,  75%);
  --gray-900:  hsl(var(--hue), 5%,  85%);
  --gray-1000: hsl(0, 4%, 100%);
  --gray-1050: hsl(0, 0%, 100%);

  /* Border */
  --border-color: hsl(225, 4%,  13%);
  --border-color-contrast: hsl(225, 4%,  15%);

  /* Accent colors,  punchy enough to pop on saturated dark surfaces */
  --red:         rgb(240, 85,  85);
  --blue:        rgb(70,  155, 255);
  --green:       rgb(50,  210, 120);
  --green-dark:  rgb(110, 225, 155);
  --yellow:      rgb(245, 195,  25);
  --orange:      rgb(245, 135,  50);
  --orange-dark: rgb(250, 170, 100);
  --purple:      rgb(175, 155, 255);
  --purple-dark: rgb(28,   18,  48);

  /* Glow effects */
  --red-glow:   rgb(255, 105, 105);
  --green-glow: rgb(10,  245, 165);
  --blue-glow:  rgb(105, 175, 255);
  --white-glow: rgb(175, 215, 255);
}
