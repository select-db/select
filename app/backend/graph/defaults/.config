{
  "statement_timeout_ms": 30000,
  "max_result_size_mb": 100, 
  "keybindings": {
    "workbench": [
      { "key": "cmd+p", "command": "workbench.openSearch", "when": "!menuFocus" },
      { "key": "cmd+w", "command": "workbench.closeActiveTab", "when": "!menuFocus" },
      { "key": "ctrl+-", "command": "workbench.previousTabInGroup", "when": "!menuFocus" },
      { "key": "ctrl+_", "command": "workbench.nextTabInGroup", "when": "!menuFocus" },
      { "key": "cmd+j", "command": "workbench.toggleLeftPanel" },
      { "key": "cmd+k", "command": "workbench.toggleRightPanel" },
      { "key": "cmd+shift+e", "command": "workbench.toggleFiles" },
      { "key": "cmd+alt+g", "command": "workbench.toggleGit" },
      { "key": "cmd+shift+f", "command": "workbench.toggleSearch" },
      { "key": "cmd+=", "command": "workbench.zoomIn" },
      { "key": "cmd+-", "command": "workbench.zoomOut" },
      { "key": "cmd+0", "command": "workbench.zoomReset" },
      { "key": "ctrl+`", "command": "workbench.openTerminal", "when": "!menuFocus" },
      { "key": "cmd+n", "command": "workbench.newSqlFile", "when": "!menuFocus" }
    ],
    "editor": [
      { "key": "cmd+s", "command": "editor.formatDocument", "when": "editorFocus" },
      { "key": "cmd+enter", "command": "editor.runQuery", "when": "editorFocus" },
      { "key": "cmd+shift+d", "command": "editor.toggleDatabasePicker" },
      { "key": "cmd+z", "command": "editor.undo", "when": "editorFocus" },
      { "key": "cmd+shift+z", "command": "editor.redo", "when": "editorFocus" },
      { "key": "cmd+y", "command": "editor.redo", "when": "editorFocus" },
      { "key": "cmd+a", "command": "editor.selectAll", "when": "editorFocus" },
      { "key": "cmd+f", "command": "editor.find", "when": "editorFocus" },
      { "key": "cmd+h", "command": "editor.replace", "when": "editorFocus" },
      { "key": "cmd+g", "command": "editor.findNext", "when": "editorFocus" },
      { "key": "cmd+shift+g", "command": "editor.findPrevious", "when": "editorFocus" },
      { "key": "cmd+d", "command": "editor.addSelectionToNextMatch", "when": "editorFocus" },
      { "key": "cmd+shift+l", "command": "editor.selectAllOccurrences", "when": "editorFocus" },
      { "key": "cmd+l", "command": "editor.selectLine", "when": "editorFocus" },
      { "key": "cmd+/", "command": "editor.toggleLineComment", "when": "editorFocus" },
      { "key": "cmd+[", "command": "editor.outdent", "when": "editorFocus" },
      { "key": "cmd+]", "command": "editor.indent", "when": "editorFocus" },
      { "key": "cmd+u", "command": "editor.cursorUndo", "when": "editorFocus" },
      { "key": "cmd+shift+k", "command": "editor.deleteLine", "when": "editorFocus" },
      { "key": "shift+enter", "command": "editor.insertLineAfter", "when": "editorFocus" },
      { "key": "cmd+shift+enter", "command": "editor.insertLineBefore", "when": "editorFocus" },
      { "key": "alt+arrowup", "command": "editor.moveLineUp", "when": "editorFocus" },
      { "key": "alt+arrowdown", "command": "editor.moveLineDown", "when": "editorFocus" },
      { "key": "shift+alt+arrowup", "command": "editor.copyLineUp", "when": "editorFocus" },
      { "key": "shift+alt+arrowdown", "command": "editor.copyLineDown", "when": "editorFocus" },
      { "key": "alt+arrowleft", "command": "editor.cursorWordLeft", "when": "editorFocus" },
      { "key": "alt+arrowright", "command": "editor.cursorWordRight", "when": "editorFocus" },
      { "key": "shift+alt+arrowleft", "command": "editor.cursorWordLeftSelect", "when": "editorFocus" },
      { "key": "shift+alt+arrowright", "command": "editor.cursorWordRightSelect", "when": "editorFocus" },
      { "key": "cmd+shift+[", "command": "editor.fold", "when": "editorFocus" },
      { "key": "cmd+shift+]", "command": "editor.unfold", "when": "editorFocus" },
      { "key": "shift+alt+f", "command": "editor.formatSelection", "when": "editorFocus" },
      { "key": "cmd+shift+o", "command": "editor.goToSymbol", "when": "editorFocus" },
      { "key": "shift+alt+i", "command": "editor.insertCursorAtEndOfEachLine", "when": "editorFocus" },
      { "key": "cmd+alt+arrowup", "command": "editor.addCursorAbove", "when": "editorFocus" },
      { "key": "cmd+alt+arrowdown", "command": "editor.addCursorBelow", "when": "editorFocus" },
      { "key": "cmd+alt+arrowleft", "command": "editor.cursorWordLeftSelect", "when": "editorFocus" },
      { "key": "cmd+alt+arrowright", "command": "editor.cursorWordRightSelect", "when": "editorFocus" },
      { "key": "cmd+backspace", "command": "editor.deleteAllLeft", "when": "editorFocus" },
      { "key": "cmd+shift+backspace", "command": "editor.deleteWordLeft", "when": "editorFocus" },
      { "key": "cmd+delete", "command": "editor.deleteAllRight", "when": "editorFocus" },
      { "key": "cmd+shift+delete", "command": "editor.deleteWordRight", "when": "editorFocus" },
      { "key": "cmd+arrowup", "command": "editor.goToTop", "when": "editorFocus" },
      { "key": "cmd+arrowdown", "command": "editor.goToBottom", "when": "editorFocus" },
      { "key": "cmd+arrowleft", "command": "editor.goToLineStart", "when": "editorFocus" },
      { "key": "cmd+arrowright", "command": "editor.goToLineEnd", "when": "editorFocus" },
      { "key": "cmd+shift+arrowleft", "command": "editor.selectToLineStart", "when": "editorFocus" },
      { "key": "cmd+shift+arrowright", "command": "editor.selectToLineEnd", "when": "editorFocus" },
      { "key": "cmd+shift+arrowup", "command": "editor.selectToTop", "when": "editorFocus" },
      { "key": "cmd+shift+arrowdown", "command": "editor.selectToBottom", "when": "editorFocus" },
      { "key": "shift+alt+a", "command": "editor.blockComment", "when": "editorFocus" },
      { "key": "shift+alt+d", "command": "editor.duplicateSelection", "when": "editorFocus" },
      { "key": "ctrl+arrowup", "command": "editor.scrollLineUp", "when": "editorFocus" },
      { "key": "ctrl+arrowdown", "command": "editor.scrollLineDown", "when": "editorFocus" },
      { "key": "cmd+shift+space", "command": "editor.triggerParameterHints", "when": "editorFocus" },
      { "key": "cmd+alt+[", "command": "editor.foldAll", "when": "editorFocus" },
      { "key": "cmd+alt+]", "command": "editor.unfoldAll", "when": "editorFocus" },
      { "key": "cmd+shift+\\", "command": "editor.jumpToBracket", "when": "editorFocus" },
      { "key": "cmd+shift+.", "command": "editor.quickFix", "when": "editorFocus" }
    ],
    "modal": [
      { "key": "escape", "command": "modal.close", "when": "modalOpen" }
    ],
    "menu": [
      { "key": "escape", "command": "menu.close", "when": "menuFocus" },
      { "key": "arrowdown", "command": "menu.selectNext", "when": "menuFocus" },
      { "key": "cmd+arrowdown", "command": "menu.selectNext", "when": "menuFocus" },
      { "key": "cmd+p", "command": "menu.selectNext", "when": "menuFocus" },
      { "key": "arrowup", "command": "menu.selectPrevious", "when": "menuFocus" },
      { "key": "cmd+arrowup", "command": "menu.selectPrevious", "when": "menuFocus" },
      { "key": "enter", "command": "menu.confirm", "when": "menuFocus" },
      { "key": "cmd+enter", "command": "menu.confirm", "when": "menuFocus" }
    ]
  },
  "editor_snippets": [
    { "prefix": "select", "body": "SELECT ${2} FROM ${1}", "description": "SELECT ... FROM ..." }
  ]
}
