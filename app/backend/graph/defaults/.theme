:root {
  /* Font sizes */
  --fs-xxs: 0.50rem;
  --fs-xs: 0.65rem;
  --fs-sm: 0.75rem;
  --fs-md: 0.875rem;
  --fs-lg: 1rem;
  --fs-xl: 1.125rem;
  --fs-xxl: 1.5rem;

  /* Font weights */
  --fw-light: 300;
  --fw-normal: 400;
  --fw-md: 500;
  --fw-bold: 600;

  /* Border */
  --bw: .5px;
  --br-xs: 0.25rem;
  --br-sm: 0.375rem;
  --br-md: 0.5rem;
}

:root[data-theme="light"] {
  /* Hue (0-360),  neutral cool gray */
  --hue: 220;

  /* Gray scale */
  --gray-0:    hsl(var(--hue), 10%, 99%);
  --gray-100:  hsl(var(--hue), 10%, 97%);
  --gray-200:  hsl(var(--hue), 10%, 95%);
  --gray-300:  hsl(var(--hue), 10%, 92%);
  --gray-400:  hsl(var(--hue), 10%, 89%);
  --gray-500:  hsl(var(--hue), 10%, 85%);
  --gray-550:  hsl(var(--hue), 10%, 80%);
  --gray-600:  hsl(var(--hue), 10%, 70%);
  --gray-700:  hsl(var(--hue), 10%, 55%);
  --gray-800:  hsl(var(--hue), 10%, 38%);
  --gray-900:  hsl(var(--hue), 12%, 20%);
  --gray-1000: hsl(var(--hue), 15%, 12%);
  --gray-1050: hsl(var(--hue), 20%, 28%);

  /* Border */
  --border-color: hsl(var(--hue), 10%, 80%);

  /* Accent colors */
  --red:         rgb(220, 53, 53);
  --blue:        rgb(59, 130, 246);
  --green:       rgb(34, 197, 94);
  --green-dark:  rgb(22, 163, 74);
  --yellow:      rgb(234, 179, 8);
  --orange:      rgb(249, 115, 22);
  --orange-dark: rgb(234, 88, 12);
  --purple:      rgb(139, 92, 246);
  --purple-dark: rgb(245, 240, 255);

  /* Glow effects */
  --red-glow:   rgb(255, 80, 80);
  --green-glow: rgb(0, 210, 130);
  --blue-glow:  rgb(59, 130, 246);
  --white-glow: rgb(200, 220, 255);
}

:root[data-theme="dark"] {
  /* Hue (0-360) */
  --hue: 225;

  /* Gray scale,  saturation tapers from rich (deep surfaces) to neutral (text) */
  --gray-0:    hsl(var(--hue), 20%, 13%);
  --gray-100:  hsl(var(--hue), 24%, 10%);
  --gray-200:  hsl(var(--hue), 22%, 7%);
  --gray-300:  hsl(var(--hue), 20%, 5%);
  --gray-400:  hsl(var(--hue), 18%, 18%);
  --gray-500:  hsl(var(--hue), 20%, 8%);
  --gray-550:  hsl(var(--hue), 16%, 22%);
  --gray-600:  hsl(var(--hue), 14%, 28%);
  --gray-700:  hsl(var(--hue), 10%, 45%);
  --gray-800:  hsl(var(--hue), 8%,  64%);
  --gray-900:  hsl(var(--hue), 5%,  85%);
  --gray-1000: hsl(var(--hue), 3%,  96%);
  --gray-1050: hsl(var(--hue), 14%, 32%);

  /* Border */
  --border-color: hsl(var(--hue), 14%, 30%);

  /* Accent colors,  punchy enough to pop on saturated dark surfaces */
  --red:         rgb(240, 85,  85);
  --blue:        rgb(70,  155, 255);
  --green:       rgb(50,  210, 120);
  --green-dark:  rgb(110, 225, 155);
  --yellow:      rgb(245, 195,  25);
  --orange:      rgb(245, 135,  50);
  --orange-dark: rgb(250, 170, 100);
  --purple:      rgb(175, 155, 255);
  --purple-dark: rgb(28,   18,  48);

  /* Glow effects */
  --red-glow:   rgb(255, 105, 105);
  --green-glow: rgb(10,  245, 165);
  --blue-glow:  rgb(105, 175, 255);
  --white-glow: rgb(175, 215, 255);
}
